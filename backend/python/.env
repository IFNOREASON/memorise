# ============================================================================
# Memorise FastAPI Backend 环境变量配置文件
# ============================================================================

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# PostgreSQL 数据库连接
# ============================================================================
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/memorise

# ============================================================================
# 阿里云百炼大模型 API 配置
# ============================================================================
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# 图像生成模型（万相）
ALIYUN_IMAGE_MODEL=wanx-v1
# 文本生成模型
ALIYUN_TEXT_MODEL=qwen-plus

# 语音相关模型
VOICE_ENROLLMENT_MODEL=qwen-voice-enrollment
VOICE_TTS_MODEL=qwen3-tts-flash-realtime
VOICE_TTS_INSTRUCT_MODEL=qwen3-tts-instruct-flash-realtime
VOICE_TARGET_MODEL=qwen3.5-omni-plus-realtime
VOICE_DEFAULT_VOICE=Cherry

# ============================================================================
# 任务重试配置
# ============================================================================
MAX_RETRY_COUNT=3
RETRY_DELAY_SECONDS=60
