# ============================================================================
# Memorise FastAPI Backend 环境变量配置文件
# ============================================================================

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# PostgreSQL 数据库连接
# ============================================================================
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
# 
# 示例:
#   本地开发: postgresql+asyncpg://postgres:postgres@localhost:5432/memorise
#   Docker环境: postgresql+asyncpg://postgres:password@db:5432/memorise
# ============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/memorise

# ============================================================================
# 阿里云百炼大模型 API 配置
# ============================================================================
# 获取 API Key: https://bailian.console.aliyun.com/
# 
# 模型说明:
# - qwen-plus: 文本理解、对话模型，用于照片分析和对话
# - wanx-v1: 图像生成模型，用于数字人生成
# ============================================================================
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ALIYUN_IMAGE_MODEL=wanx-v1
ALIYUN_TEXT_MODEL=qwen-plus

# ============================================================================
# 任务重试配置
# ============================================================================
# 用于数字人生成失败时的自动重试
# - MAX_RETRY_COUNT: 最大重试次数 (默认: 3)
# - RETRY_DELAY_SECONDS: 初始重试延迟秒数，采用指数退避 (默认: 60)
# 
# 重试时间序列: 60s -> 120s -> 300s -> 600s (约10分钟后停止自动重试)
# 手动重试可通过 API 触发: POST /api/avatars/retry
# ============================================================================
MAX_RETRY_COUNT=3
RETRY_DELAY_SECONDS=60
